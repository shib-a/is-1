  <persistence-unit name="workerManagement" transaction-type="RESOURCE_LOCAL">  <!-- IMPORTANT: change to RESOURCE_LOCAL for dev -->
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>ru.itmo.model.Worker</class>
        <class>ru.itmo.model.Organization</class>
        <class>ru.itmo.model.Person</class>
        <class>ru.itmo.model.Coordinates</class>
        <class>ru.itmo.model.Address</class>
        <class>ru.itmo.model.Location</class>

    <exclude-unlisted-classes>false</exclude-unlisted-classes>

    <properties>

      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/postgres?currentSchema=is"/>
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.password" value="NUTd/6706"/>


      <property name="eclipselink.jdbc.schema" value="is"/>


      <property name="eclipselink.ddl-generation" value="drop-and-create-tables"/>
      <property name="eclipselink.ddl-generation.output-mode" value="database"/>


      <property name="eclipselink.deploy-on-startup" value="true"/>


      <property name="eclipselink.logging.level" value="FINEST"/>
      <property name="eclipselink.logging.parameters" value="true"/>
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.level.ddl" value="FINE"/>


      <property name="eclipselink.weaving" value="false"/>


      <property name="eclipselink.media.type" value="application/json"/>
    </properties>
  </persistence-unit>
</persistence>
