<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="workerManagement" transaction-type="JTA">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>ru.itmo.model.Worker</class>
    <class>ru.itmo.model.Organization</class>
    <class>ru.itmo.model.Person</class>
    <class>ru.itmo.model.Coordinates</class> <!-- если это @Embeddable, можно не указывать, но на всякий случай -->
    <class>ru.itmo.model.Address</class>
    <class>ru.itmo.model.Location</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.password" value="NUTd/6706"/>
      <property name="jakarta.persistence.jdbc.url" value="localhost:5432"/>
      <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
      <property name="jakarta.persistence.schema-generation.create-source" value="metadata"/>
      <property name="jakarta.persistence.schema-generation.default_schema" value="is"/>
      <property name="eclipselink.weaving" value="false"/>
      <property name="eclipselink.logging.level.sql" value="FINE"/>
      <property name="eclipselink.logging.parameters" value="true"/>
      <property name="eclipselink.media.type" value="application/json"/>
      <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.PostgreSQLPlatform"/>
    </properties>
  </persistence-unit>
</persistence>
